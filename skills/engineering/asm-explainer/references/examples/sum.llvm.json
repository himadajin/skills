     "note": "合計を返す"
    }
   ],
   "successors": []
  },
  {
   "id": "for.body",
   "label": "for.body",
   "summary": "ループ本体：a[i] を読んで足し、i を進める。",
   "explanation": "2 つの phi が添字 %i.06 と合計 %s.05 を受け取る（初回は 0、2 回目以降は前の周の %inc / %add）。`getelementptr` で &a[i] を作り、load して足す。%inc == n なら true でループを抜け、そうでなければ false で for.body に戻る（back-edge）。",
   "instructions": [
    {
     "text": "%i.06 = phi i64 [ %inc, %for.body ], [ 0, %entry ]",
     "defs": [
      "%i.06"
     ],
     "uses": [],
     "note": "i：初回 0、以降 i+1"
    },
    {
     "text": "%s.05 = phi i64 [ %add, %for.body ], [ 0, %entry ]",
     "defs": [
      "%s.05"
     ],
     "uses": [],
     "note": "s：初回 0、以降 前回の合計"
    },
    {
     "text": "%arrayidx = getelementptr inbounds i64, ptr %a, i64 %i.06",
     "defs": [
      "%arrayidx"
     ],
     "uses": [
      "%a",
      "%i.06"
     ],
     "note": "&a[i] を計算"
    },
    {
     "text": "%0 = load i64, ptr %arrayidx, align 8",
     "defs": [
      "%0"
     ],
     "uses": [
      "%arrayidx"
     ],
     "note": "a[i] を読む"
    },
    {
     "text": "%add = add nsw i64 %0, %s.05",
     "defs": [
      "%add"
     ],
     "uses": [
