     "note": "n > 0 ?"
    },
    {
     "text": "br i1 %cmp4, label %for.body, label %for.cond.cleanup",
     "defs": [],
     "uses": [
      "%cmp4"
     ],
     "note": "true ならループへ、false なら出口へ"
    }
   ],
   "successors": [
